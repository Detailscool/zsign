{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zsign Desktop",
  "version": "0.1.0",
  "identifier": "com.zsign.desktop",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "zsign Desktop", "width": 720, "height": 560, "minWidth": 600, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' asset:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
